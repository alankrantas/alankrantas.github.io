{
	"name": "alankrantas.github.io",
	"version": "1.1.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"upgrade-all": "yarn-upgrade-all && yarn upgrade",
		"dev": "vite dev --port 3000 --open --host",
		"preview": "vite preview --port 8080 --open --host",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"start": "yarn dev",
		"serve": "yarn preview",
		"pull": "git pull origin main",
		"push": "git add . && git commit -m \"User updating\" && git push origin main",
		"commit": "yarn pull && yarn format && yarn push"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource/noto-sans-tc": "^5.3.0",
		"@fontsource/open-sans": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"bootstrap": "^5.3.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"type": "module"
}
